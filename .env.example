# ==============================================================================
# English Lab — Environment Configuration (.env.example)
# ==============================================================================
# By default, NO environment variables are required. 
# English Lab runs out-of-the-box on Vercel using the bundled data/words.json.

# Optional: Override remote GitHub URL for custom dictionary updates
# GITHUB_WORDS_URL=https://raw.githubusercontent.com/muzaffarbekmustafayev/english-lab/main/data/words.json

# Optional: Force fetching from GitHub instead of the fast local words.json (default: false)
# FORCE_REMOTE_GITHUB=false
